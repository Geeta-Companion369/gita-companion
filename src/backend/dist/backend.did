type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type YugCycle = 
 record {
   characteristics: text;
   description: text;
   dharmaQuarter: nat;
   durationYears: nat;
   id: text;
   name: text;
   sanskritName: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
 };
type WorshipStep = 
 record {
   description: text;
   id: text;
   mantra: text;
   name: text;
   procedure: text;
   sanskritName: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
   stepNumber: nat;
 };
type VerseCommentary = 
 record {
   ramanuja: text;
   shankaracharya: text;
   tilak: text;
   verseId: text;
 };
type Verse = 
 record {
   chapterId: nat;
   englishTranslation: text;
   id: nat;
   sanskritText: text;
   transliteration: text;
   verseNumber: text;
 };
type VedaName = 
 variant {
   atharva;
   rig;
   sama;
   yajur;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserProfileInput = 
 record {
   dateOfBirth: DateOfBirth;
   email: text;
   fullName: text;
   latitude: float64;
   longitude: float64;
   newsletterOptIn: bool;
   phone: text;
   placeOfBirth: text;
   timeOfBirth: TimeOfBirth;
   timezone: text;
 };
type UserProfile = 
 record {
   createdAt: int;
   dateOfBirth: DateOfBirth;
   email: text;
   fullName: text;
   id: principal;
   latitude: float64;
   longitude: float64;
   newsletterOptIn: bool;
   phone: text;
   placeOfBirth: text;
   timeOfBirth: TimeOfBirth;
   timezone: text;
   updatedAt: int;
 };
type UpanishadName = 
 variant {
   aitareya;
   brihadaranyaka;
   chandogya;
   isha;
   katha;
   kena;
   mandukya;
   mundaka;
   prashna;
   shvetashvatara;
   taittiriya;
 };
type TransitEvent = 
 record {
   colorCode: text;
   description: text;
   endDate: text;
   eventType: text;
   planet: text;
   remedy: text;
   startDate: text;
 };
type TimeOfBirth = 
 record {
   hour: nat;
   minute: nat;
 };
type TarotReading = 
 record {
   draws: vec TarotDraw;
   guidance: text;
   id: text;
   interpretation: text;
   principalId: text;
   question: text;
   readAt: int;
   spreadType: text;
 };
type TarotDraw = 
 record {
   cardId: text;
   isReversed: bool;
   position: nat;
   positionName: text;
 };
type TarotCard = 
 record {
   arcana: text;
   id: text;
   imagery: text;
   name: text;
   number: nat;
   reversedMeaning: text;
   suit: text;
   symbolism: text;
   uprightMeaning: text;
 };
type SiddhiEntry = 
 record {
   category: SiddhiCategory;
   description: text;
   guruDisclaimer: text;
   id: text;
   name: text;
   sanskritName: text;
   significance: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
 };
type SiddhiCategory = 
 variant {
   kala;
   mahavidya;
   nidhi;
   siddhi;
 };
type ShauchaPractice = 
 record {
   benefits: vec text;
   description: text;
   id: text;
   kind: text;
   name: text;
   practice: text;
   sanskritName: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
 };
