 };
type AdminConfigInput = 
 record {
   appVersion: text;
   newsletterEnabled: bool;
   senderEmail: text;
   senderName: text;
 };
type AdminConfig = 
 record {
   appVersion: text;
   newsletterEnabled: bool;
   senderEmail: text;
   senderName: text;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  adminListAllGalleryImages: () -> (vec GalleryImageMeta);
  clearOldMessages: () -> ();
  createJournalEntry: (verseId: text, "text": text, mood: text) ->
   (JournalEntry);
  deleteJournalEntry: (id: text) -> (bool);
  drawTarot: (spreadType: text, question: text) -> (TarotReading);
  execute: (qJson: text) -> (Result) query;
  getAdminConfig: () -> (AdminConfig) query;
  getAllGrahaRemedies: () -> (vec GrahaRemedyData) query;
  getChapter: (chapterId: nat) -> (opt Chapter) query;
  getCircleMessages: (circleId: text) -> (vec SatsangMessage) query;
  getConcentrationHistory: (limit: nat) -> (vec ConcentrationSession) query;
  getDailyChallenge: (dateKey: text) -> (opt DailyChallenge) query;
  getDailyDuty: (id: text) -> (opt DailyDuty) query;
  getDailyQuiz: (date: text) -> (opt QuizQuestion) query;
  getDevlokStage: (id: text) -> (opt DevlokStage) query;
  getDharmaBodhStep: (id: text) -> (opt DharmaBodhStep) query;
  getDharmaPillar: (id: text) -> (opt DharmaPillar) query;
  getDikshaVidhi: (id: text) -> (opt DikshaVidhi) query;
  getDonationInfo: () -> (opt DonationInfo) query;
  getFestivals: () -> (vec Festival) query;
  getGalleryUploads: () -> (vec GalleryImageMeta) query;
  getGrahaRemedy: (graha: text) -> (opt GrahaRemedyData) query;
  getGranth: (granthId: text) -> (opt Granth) query;
  getGranthChapter: (granthId: text, chapterId: nat) ->
   (opt GranthChapter) query;
  getGranthVerse: (granthId: text, chapterId: nat, verseId: nat) ->
   (opt GranthVerse) query;
  getGuidanceByCategory: (category: text) -> (opt GuidanceResult) query;
  getHeatmapData: (days: nat) -> (vec HeatmapEntry) query;
  getJournalEntries: () -> (vec JournalEntry) query;
  getKala: (id: text) -> (opt SiddhiEntry) query;
  getKarmaType: (id: text) -> (opt KarmaType) query;
  getKrishnaGuidance: (keyword: text) -> (opt GuidanceResult) query;
  getKundliData: () -> (opt KundliData) query;
  getLastRiteStep: (id: text) -> (opt LastRiteStep) query;
  getLeaderboard: (limit: nat) -> (vec LeaderboardEntry) query;
  getMahavidya: (id: text) -> (opt SiddhiEntry) query;
  getMantras: () -> (vec MantraEntry) query;
  getMaunaPractice: (id: text) -> (opt MaunaPractice) query;
  getMokshaTeaching: (id: text) -> (opt MokshaTeaching) query;
  getNaamPledges: () -> (vec NaamPledge) query;
  getNidhi: (id: text) -> (opt SiddhiEntry) query;
  getPanchaang: (dateStr: text) -> (PanchangData) query;
  getPanchangToday: (date: text) -> (PanchangData) query;
  getPitruRite: (id: text) -> (opt PitruRite) query;
  getPregnancyWeek: (weekNumber: nat) -> (opt PregnancyWeek) query;
  getPunyaProfile: () -> (opt PunyaProfile);
  getReadingStreak: () -> (nat) query;
  getRemedyReminder: () -> (opt RemedyReminder) query;
  getRitualExplanation: (id: text) -> (opt RitualExplanation) query;
  getSampradaya: (id: text) -> (opt Sampradaya) query;
  getSanskaar: (id: text) -> (opt Sanskaar) query;
  getSatsangCircle: (circleId: text) -> (opt SatsangCircle) query;
  getShauchaPractice: (id: text) -> (opt ShauchaPractice) query;
  getSiddhi: (id: text) -> (opt SiddhiEntry) query;
  getTarotCard: (id: text) -> (opt TarotCard) query;
  getTransitCalendar: (year: nat) -> (vec TransitEvent) query;
  getUserProfile: () -> (opt UserProfile) query;
  getVerse: (chapterId: nat, verseId: nat) -> (opt Verse) query;
  getVerseCommentary: (verseId: text) -> (opt VerseCommentary) query;
  getWorshipStep: (id: text) -> (opt WorshipStep) query;
  getYugCycle: (id: text) -> (opt YugCycle) query;
  listChapters: () -> (vec Chapter) query;
  listDailyDuties: () -> (vec DailyDuty) query;
  listDevlokStages: () -> (vec DevlokStage) query;
  listDharmaBodhSteps: () -> (vec DharmaBodhStep) query;
  listDharmaPillars: () -> (vec DharmaPillar) query;
  listGranthChapters: (granthId: text) -> (vec GranthChapter) query;
  listGranthVerses: (granthId: text, chapterId: nat) ->
   (vec GranthVerse) query;
  listGranths: () -> (vec Granth) query;
  listKalas: () -> (vec SiddhiEntry) query;
  listKarmaTypes: () -> (vec KarmaType) query;
  listLastRiteSteps: () -> (vec LastRiteStep) query;
  listMahavidyas: () -> (vec SiddhiEntry) query;
  listMaunaPractices: () -> (vec MaunaPractice) query;
  listMokshaTeachings: () -> (vec MokshaTeaching) query;
  listNewsletterSubscribers: () -> (vec EmailSubscriber);
  listNidhis: () -> (vec SiddhiEntry) query;
  listPitruRites: () -> (vec PitruRite) query;
  listPregnancyWeeks: () -> (vec PregnancyWeek) query;
  listRitualExplanations: () -> (vec RitualExplanation) query;
  listSampradayas: () -> (vec Sampradaya) query;
  listSanskaars: () -> (vec Sanskaar) query;
  listSatsangCircleMetadata: () -> (vec SatsangCircle) query;
  listSatsangCircles: () -> (vec text) query;
  listShauchaPractices: () -> (vec ShauchaPractice) query;
  listSiddhis: () -> (vec SiddhiEntry) query;
  listTarotCards: () -> (vec TarotCard) query;
  listVerses: (chapterId: nat) -> (vec Verse) query;
  listWorshipSteps: () -> (vec WorshipStep) query;
  listYugCycles: () -> (vec YugCycle) query;
  postCircleMessage: (circleId: text, authorName: text, message: text) -> ();
  recordConcentrationSession: (durationMinutes: nat, sessionType: text) ->
   (ConcentrationSession);
  recordDailyReading: (date: text, versesRead: nat, chaptersRead: nat,
   allGoalsMet: bool) -> (HeatmapEntry);
  saveKundliData: (data: KundliData) -> (bool);
  saveRemedyReminder: (graha: text, time: text) -> (bool);
  saveUserProfile: (input: UserProfileInput) -> (bool);
  schema: () -> (text) query;
  searchJournalEntries: (searchText: text) -> (vec JournalEntry) query;
  setDonationInfo: (input: DonationInfoInput) -> (bool);
  setGalleryImageApproval: (id: nat, approved: bool) -> (bool);
  subscribeNewsletter: (email: text, name: text) -> (bool);
  unsubscribeNewsletter: (email: text) -> (bool);
  updateAdminConfig: (config: AdminConfigInput) -> (bool);
  updateJournalEntry: (id: text, "text": text, mood: text) ->
   (opt JournalEntry);
  uploadGalleryImage: (input: GalleryImageInput) -> (nat);
}
