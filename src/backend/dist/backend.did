   rulingPlanet: text;
   rulingPlanetGlyph: text;
 };
type KarmaType = 
 record {
   description: text;
   id: text;
   name: text;
   practice: text;
   sanskritName: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
 };
type JournalEntry = 
 record {
   createdAt: int;
   id: text;
   mood: text;
   principalId: text;
   "text": text;
   updatedAt: int;
   verseId: text;
 };
type HeatmapEntry = 
