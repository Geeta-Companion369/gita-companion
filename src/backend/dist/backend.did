 };
type GranthVerse = 
 record {
   chapterId: nat;
   granthId: text;
   sanskritDevanagari: text;
   sanskritTransliteration: text;
   simpleMeaning: text;
   sourceChapter: nat;
   sourceGranth: text;
   sourceVerse: text;
   verseId: nat;
   verseNumber: text;
 };
