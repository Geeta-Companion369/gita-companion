   lagnaRashi: text;
   lagnaSign: nat;
   mahadasha: DashaEntry;
   navamsaLagnaSign: nat;
   navamsaPlanets: vec PlanetPlacement;
   nextDashas: vec DashaEntry;
   planets: vec PlanetPlacement;
