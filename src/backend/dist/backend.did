 record {
   description: text;
   granthType: GranthType;
   id: text;
   name: text;
   sanskritName: text;
   sourceCitation: text;
   totalChapters: nat;
 };
type GrahaRemedyData = 
 record {
   avoidList: vec text;
   daan: text;
   gemstone: text;
   gemstoneWarning: text;
   graha: text;
   mantraCount: nat;
   mantraSanskrit: text;
   remedies: vec text;
   role: text;
   strongGives: vec text;
   weakCauses: vec text;
 };
type GalleryImageMeta = 
 record {
   asset: ExternalBlob;
   caption: text;
   category: text;
   id: nat;
   isApproved: bool;
   uploadedAt: int;
   uploader: principal;
 };
