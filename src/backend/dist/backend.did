 };
type SatsangCircle = 
 record {
   description: text;
   iconGlyph: text;
   id: text;
   memberCount: nat;
   name: text;
 };
type Sanskaar = 
 record {
   description: text;
   id: text;
   mantra: text;
   name: text;
   procedure: vec text;
   sanskaarNumber: nat;
   sanskritName: text;
   significance: text;
   sourceChapter: text;
   sourceGranth: text;
   sourceVerse: text;
   timing: text;
 };
type Sampradaya = 
 record {
   founder: text;
